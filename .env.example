# Supabase project (create at https://supabase.com, then paste values here into .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Milestone 2) — Resend
RESEND_API_KEY=
# The address must sit on the verified Resend sending domain or every send is
# rejected. The display name here is only a fallback: each send goes out under
# the sending agency's own name, because the family met them, not us.
EMAIL_FROM="Porchlight <hello@example.com>"
# Optional, and a mailbox that actually accepts mail. The sending subdomain
# does not, so without this a family who answers a nurture email — which four
# templates invite them to do — is writing into a void.
EMAIL_REPLY_TO=

# Secrets for system endpoints
CRON_SECRET=
INBOUND_WEBHOOK_SECRET=

# Base URL used in QR codes / share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
